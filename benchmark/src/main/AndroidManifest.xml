<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Заполнение журнала вызовов эмулятора тестовыми звонками перед съёмкой
      профиля запуска (1.3.4, CallLogSeed): без этого журнал пуст, и код
      строк журнала и свайпа в профиль не попадает. Только на эмуляторе —
      CallLogSeed проверяет Build.HARDWARE; разрешение выдаёт pm grant.
    -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
</manifest>
