# ШАБЛОН НАСТРОЕК ПОДПИСИ РЕЛИЗА.
#
# Скопируйте в keystore.properties и заполните. Настоящий файл
# в репозиторий НЕ попадает: он в .gitignore.
#
# Ключ создаётся один раз командой:
#   keytool -genkey -v -keystore ogneliss-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias ogneliss
#
# ⚠️ СОХРАНИТЕ КЛЮЧ И ПАРОЛИ В НАДЁЖНОМ МЕСТЕ.
# Google Play привязывает приложение к ключу навсегда. Потеря ключа
# означает невозможность выпустить обновление — придётся публиковать
# новое приложение с нуля, потеряв все установки и отзывы.
#
# Play App Signing частично страхует от этого: Google хранит основной
# ключ, а вы подписываете загрузочным. Включать при первой публикации.

storeFile=../ogneliss-release.jks
storePassword=ЗАМЕНИТЬ
keyAlias=ogneliss
keyPassword=ЗАМЕНИТЬ
