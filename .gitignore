keystore.properties
# Ключ подписи в репозитории означает, что любой с доступом к коду
# может выпустить обновление вашего приложения. Отозвать нельзя
*.jks
*.keystore

# ВАЖНО: app/schemas НЕ игнорируется — схемы Room нужны для тестов миграций
!app/schemas/

# Трассы Perfetto холодного запуска — по несколько МБ, только для разбора (1.3.5)
docs/baseline/traces/

# Журналы диагностики и дампы памяти: в них бывают номера и имена
# с телефона, а код открыт (1.5.7)
*.log
*.hprof

# Служебные файлы Kotlin 2.x (сеансы компилятора) — не код
.kotlin/
