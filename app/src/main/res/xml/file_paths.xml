<?xml version="1.0" encoding="utf-8"?>
<!--
  Пути, которые разрешено отдавать наружу через FileProvider.
  Открыт ТОЛЬКО каталог share/ с подготовленным файлом лога.
  Каталоги с базой, настройками и сырыми логами наружу не отдаются.
-->
<paths>
    <files-path name="shared_logs" path="share/" />
    <!--
      1.10.0: обмен MMS со службой телефона — скачанное и отправляемое
      сообщение (MmsTransport). Доступ выдаётся на один файл и на время
      обмена; после обработки файл удаляется.
    -->
    <cache-path name="mms" path="mms/" />
</paths>
