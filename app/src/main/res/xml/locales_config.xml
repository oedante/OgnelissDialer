<?xml version="1.0" encoding="utf-8"?>
<!--
  Список поддерживаемых языков.
  Чтобы добавить новый: создать values-<code>/strings.xml и дописать locale сюда.
  Больше ничего менять не нужно — системный переключатель языка и наш
  экран выбора читают этот файл.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ru" />
    <locale android:name="de" />
    <locale android:name="fr" />
    <!--
        Переводы ниже делает Google Play (Gemini) при публикации бандла
        (с 1.2.2 — 44 языка, список как в Play Console) —
        в исходниках их нет. Здесь языки перечислены, чтобы их можно было
        выбрать вручную: в выборе языка приложения и в системной настройке
        «Язык приложения». В сборке, установленной не из Google Play,
        переводов нет — приложение покажет английский.
    -->
    <locale android:name="ar" />
    <locale android:name="bn" />
    <locale android:name="bg" />
    <locale android:name="ca" />
    <locale android:name="zh-CN" />
    <locale android:name="hr" />
    <locale android:name="cs" />
    <locale android:name="da" />
    <locale android:name="nl" />
    <locale android:name="et" />
