<?xml version="1.0" encoding="utf-8"?>
<!--
  МНОЖЕСТВЕННЫЕ ЧИСЛА.
  Нельзя склеивать число и существительное вручную: в русском три формы
  (1 минута, 2 минуты, 5 минут), в английском две, в арабском шесть.
  Android выбирает нужную форму сам по правилам CLDR.
-->
<resources>
    <plurals name="duration_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="duration_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
    <plurals name="call_count">
        <item quantity="one">%d call</item>
        <item quantity="other">%d calls</item>
    </plurals>
    <plurals name="blocked_count">
        <item quantity="one">%d blocked number</item>
        <item quantity="other">%d blocked numbers</item>
    </plurals>
    <plurals name="selected_count">
        <item quantity="one">%d selected</item>
        <item quantity="other">%d selected</item>
    </plurals>
    <plurals name="selection_delete_text">
        <item quantity="one">%d entry will be removed from the call history. This cannot be undone.</item>
        <item quantity="other">%d entries will be removed from the call history. This cannot be undone.</item>
    </plurals>
    <plurals name="filter_match_count">
        <item quantity="one">%1$d call matches</item>
        <item quantity="other">%1$d calls match</item>
    </plurals>
</resources>
