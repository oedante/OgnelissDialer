<?xml version="1.0" encoding="utf-8"?>
<!--
  ЭКРАН ЗАПУСКА.

  ── Что изменилось ─────────────────────────────────────────────────────────
  Раньше система показывала иконку приложения на тёмном фоне. Иконка
  рассчитана на размер 48 dp в списке приложений, и растянутая до размера
  заставки она выглядела нерезкой.

  Теперь:
  • фон — сплошной цвет, а не изображение. Он рисуется мгновенно
    и не требует декодирования, то есть заставка появляется быстрее;
  • в центре — векторный логотип, который не теряет чёткости
    ни на каком экране;
  • внизу название приложения через штатное поле брендирования.
    Это единственный поддерживаемый способ показать текст на заставке:
    произвольную разметку Splash Screen API не принимает.
-->
<resources>
    <style name="Theme.Ogneliss.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!--
          Растровый логотип вместо вектора.

          Векторная версия рисовалась вручную и вышла неточной.
          Растр из mipmap имеет достаточное разрешение: система
          масштабирует его под размер заставки, и на телефонах
          это незаметно.

          Когда появится аккуратный вектор, вернуть @drawable/ic_splash_logo.
        -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!--
          БРЕНДИРОВАНИЕ УБРАНО ИЗ БАЗОВОЙ ТЕМЫ.

          windowSplashScreenBrandingImage существует только начиная
          с Android 12 (API 31). В базовой теме атрибут не находится
          вовсе, и сборка падает с «attribute not found» — причём
          на этапе сборки ресурсов, а не выполнения.

          Название приложения задано в values-v31, где атрибут
          поддерживается. На более старых версиях заставка покажет
          только логотип — это штатное поведение, а не ошибка.
        -->
        <item name="postSplashScreenTheme">@style/Theme.OgnelissDialer</item>
    </style>
</resources>
