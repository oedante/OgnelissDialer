<resources>
    <!--
      ФОН ОКНА ЗАДАН ЦВЕТОМ.

      ── Почему не @null ────────────────────────────────────────────────────
      Убирать фон окна ради экономии слоёв отрисовки — приём верный,
      но только когда приложение само закрашивает весь экран.

      У нас Scaffold отступает от системных панелей, и область статусбара
      остаётся ничем не закрашенной: система показывает там чёрный фон
      окна по умолчанию, а при прокрутке в этой полосе проступают
      остатки предыдущих кадров — те самые артефакты.

      Сплошной цвет закрывает полосу и стоит один слой на весь экран.
      Экономия от @null того не стоила.

      ── Почему именно этот цвет ────────────────────────────────────────────
      Совпадает с фоном светлой темы. Для тёмной значение переопределено
      в values-night: без этого при запуске в тёмной теме мелькала бы
      белая вспышка.
    -->
    <style name="Theme.OgnelissDialer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.OgnelissDialer.InCall" parent="Theme.OgnelissDialer" />
</resources>
