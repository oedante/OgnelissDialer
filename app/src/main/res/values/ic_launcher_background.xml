<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Фон адаптивного значка.

      Был тёмный графит #2E2E30: на нём читалась белая лиса прежнего логотипа.
      У нового значка фон кремовый и является частью самой картинки, поэтому
      цвет здесь должен точно совпадать с фоном исходника — иначе на месте
      стыка слоя foreground и фона будет видна рамка.
      #F9F5E9 — цвет, взятый пипеткой из исходного PNG.
    -->
    <color name="ic_launcher_background">#F9F5E9</color>
    <!--
      Цвета бренда, взяты из нового значка. Оранжевый стал чуть светлее
      прежнего #FAA814, тёмный — синее прежнего #2E2E30.
    -->
    <color name="brand_flame">#F9BC3A</color>
    <color name="brand_dark">#3F465E</color>
</resources>
