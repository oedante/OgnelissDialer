<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Фон адаптивного значка — тёмный графит #2E3138 (значок 1.4.0, 11.10.2026).

      Значок нарисован на ровном тёмном фоне; рисунок (белая трубка,
      оранжевое пламя, белая лиса) вынесен в слой foreground с прозрачным
      фоном — scripts/make_icons.py. Цвет здесь обязан совпадать с фоном
      исходника store/source/icon_master_1024.png: края рисунка рассчитаны
      поверх этого цвета, и make_icons.py сверяет его при каждой сборке.

      Прежний значок (1.0.14–1.3.6) был кремовым, #F9F5E9.
    -->
    <color name="ic_launcher_background">#2E3138</color>
    <!--
      Цвета бренда — из значка 1.4.0: пламя #F7A901, фон #2E3138.
      Тот же стиль, что у значка Ogneliss Mail (фон #2F343A).
    -->
    <color name="brand_flame">#F7A901</color>
    <color name="brand_dark">#2E3138</color>
</resources>
