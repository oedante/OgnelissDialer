<?xml version="1.0" encoding="utf-8"?>
<!--
    Значок ярлыка «Псевдозвонок» в меню долгого нажатия.

    ══════════════════════════════════════════════════════════════════════
    ПОЧЕМУ БЫЛ БЕЛЫЙ КРУГ
    ══════════════════════════════════════════════════════════════════════
    В ярлык отдавался тот же значок, что в меню приложения: белая фигура
    с оттенком из темы. Лаунчер рисует ярлыки в своём процессе, нашей
    темы там нет, и оттенок не применялся; а подложку лаунчер ставит
    свою — белую. Белое на белом и давало пустой круг.

    Ярлыки контактов этим не страдают: у них фотография, а не фигура.

    Здесь значок полный — подложка своего цвета плюс фигура поверх.
    Зелёный — цвет кнопки «Ответить»: псевдозвонок имитирует входящий
    вызов, и цвет подсказывает это раньше подписи.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/shortcut_fake_call_bg" />
    <foreground android:drawable="@drawable/ic_shortcut_fake_call_fg" />
</adaptive-icon>
